# ==================================================
# ARGUS Environment Configuration
# ==================================================
# Copy this file to .env and modify as needed.
# NEVER commit .env — it is in .gitignore.

# --- Core ---
ARGUS_ENV=development
ARGUS_USE_MOCKS=true
ARGUS_DEBUG=true

# --- Provider Selection ---
ARGUS_LLM_PROVIDER=fake          # Options: fake, bedrock
ARGUS_VISION_PROVIDER=mock       # Options: mock, local
ARGUS_STORAGE_PROVIDER=local     # Options: local, aws

# --- API Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite requires VITE_ prefix) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCKS=true

# --- AWS (optional, uncomment when needed) ---
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=
# BEDROCK_MODEL_ID=
# ARGUS_S3_BUCKET=
# ARGUS_DYNAMODB_TABLE=
